# Generate a strong password/hash on first launch in the setup screen.
APP_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
WORKSPACE_DIR=./workspace

# Choose: ollama (local) or openai_compatible (hosted or compatible endpoint)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# For OpenAI-compatible providers:
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Search is optional; install ddgs for web search support.
